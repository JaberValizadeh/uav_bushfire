# RViz for the whole incident at once.
#
# The fixed frame is world, and that is the whole reason one config can show
# three aircraft and a shared fire ground. message_to_tf gives every drone a
# world -> <ns>/base_link transform off its own ground truth, and fire_spotter
# stamps its markers world rather than any drone's odom frame, so the trees
# meet at a common root and nothing has to be transformed between them.
#
# There is one marker display rather than three, because there is one fire
# ground. fire_spotter publishes every flame and every intensity label on a
# single latched MarkerArray - which is the visible half of the change from a
# private target per drone to a shared incident.
Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: false
      Marker Alpha: 1
      Marker Scale: 0.5
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Tree:
        {}
      Update Interval: 0
      Value: false

    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Link Tree Style: Links in Alphabetic Order
      Name: uav_0 model
      Robot Description: /uav_0/robot_description
      TF Prefix: uav_0
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Link Tree Style: Links in Alphabetic Order
      Name: uav_1 model
      Robot Description: /uav_1/robot_description
      TF Prefix: uav_1
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Link Tree Style: Links in Alphabetic Order
      Name: uav_2 model
      Robot Description: /uav_2/robot_description
      TF Prefix: uav_2
      Update Interval: 0
      Value: true
      Visual Enabled: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /bushfire/markers
      Name: fire ground
      Namespaces:
        {}
      Queue Size: 100
      Value: true

    # The scan each suppressor actually steers by. Worth having on when the
    # question is why an aircraft stopped: what the safety filter saw is
    # exactly what is drawn here. Note it sees trunks only - the canopies
    # carry no collision, so nothing of them appears in a scan.
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz/LaserScan
      Color: 255; 90; 90
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: uav_0 scan
      Position Transformer: XYZ
      Queue Size: 10
      Size (m): 0.05
      Style: Spheres
      Topic: /uav_0/scan
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz/LaserScan
      Color: 90; 255; 120
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: uav_1 scan
      Position Transformer: XYZ
      Queue Size: 10
      Size (m): 0.05
      Style: Spheres
      Topic: /uav_1/scan
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz/LaserScan
      Color: 120; 170; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: uav_2 scan
      Position Transformer: XYZ
      Queue Size: 10
      Size (m): 0.05
      Style: Spheres
      Topic: /uav_2/scan
      Use Fixed Frame: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 22
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.699999988079071
      Target Frame: <Fixed Frame>
      Yaw: 0.7853981852531433
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 1400
